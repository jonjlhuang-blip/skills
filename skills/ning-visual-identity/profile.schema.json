{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directly reviewed visual identity input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "review_method", "reference_policy", "identity_features", "reference_observations", "generation", "unknowns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "presentation"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "presentation": {"$ref": "#/$defs/text"}}
    },
    "review_method": {"const": "direct_visual_review"},
    "reference_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_id", "auxiliary_ids", "notes"],
      "properties": {
        "primary_id": {"$ref": "#/$defs/referenceId"},
        "auxiliary_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/referenceId"}},
        "notes": {"$ref": "#/$defs/textList"}
      }
    },
    "identity_features": {
      "type": "object", "additionalProperties": false,
      "required": ["face_outline", "eyes", "brows", "nose", "mouth", "hair", "skin", "body_silhouette"],
      "properties": {
        "face_outline": {"$ref": "#/$defs/observation"},
        "eyes": {"$ref": "#/$defs/observation"},
        "brows": {"$ref": "#/$defs/observation"},
        "nose": {"$ref": "#/$defs/observation"},
        "mouth": {"$ref": "#/$defs/observation"},
        "hair": {"$ref": "#/$defs/observation"},
        "skin": {"$ref": "#/$defs/observation"},
        "body_silhouette": {"$ref": "#/$defs/observation"}
      }
    },
    "reference_observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference_id", "role", "pose", "expression", "clothing", "lighting", "framing", "scene", "differences", "limitations"],
        "properties": {
          "reference_id": {"$ref": "#/$defs/referenceId"},
          "role": {"enum": ["primary", "auxiliary"]},
          "pose": {"$ref": "#/$defs/text"},
          "expression": {"$ref": "#/$defs/text"},
          "clothing": {"$ref": "#/$defs/text"},
          "lighting": {"$ref": "#/$defs/text"},
          "framing": {"$ref": "#/$defs/text"},
          "scene": {"$ref": "#/$defs/text"},
          "differences": {"$ref": "#/$defs/textList"},
          "limitations": {"$ref": "#/$defs/textList"}
        }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["target_scene", "avoid"],
      "properties": {"target_scene": {"$ref": "#/$defs/text"}, "avoid": {"$ref": "#/$defs/textList"}}
    },
    "unknowns": {"$ref": "#/$defs/textList"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "textList": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "referenceId": {"type": "string", "pattern": "^reference_[0-9]{2,}$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "confidence", "evidence", "limitations"],
      "properties": {
        "description": {"$ref": "#/$defs/text"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/referenceId"}},
        "limitations": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
